# Docker Compose
DATABASE_URL=postgresql+psycopg://petspace:petspace@db:5432/petspace
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
VITE_API_URL=http://localhost:8000/api/v1

# Порт Postgres на хосте. 5433 выбран потому, что 5432 часто занят
# локальным Postgres/Postgres.app; внутри compose адрес всегда db:5432.
POSTGRES_PORT=5433

# Локальная разработка: код входа возвращается в ответе API и виден на экране входа,
# чтобы демо работало без почтового провайдера. В prod этот флаг запрещён валидатором.
EXPOSE_DEV_OTP=true

# Local backend (without Docker):
# DATABASE_URL=postgresql+psycopg://petspace:petspace@localhost:5433/petspace
# OLLAMA_BASE_URL=http://localhost:11434
